DB_HOST=localhost
DB_USER=root
DB_PW=
DB_NAME=vehicle-t6
AUTH_SECRET=change-me-in-production
PORT=3200
NODE_ENV=development
# In development, schema changes auto-apply on server start (set false to disable).
SEQUELIZE_SYNC_ALTER=true

# Google sign-in (Feature 1)
GOOGLE_CLIENT_ID=
# Initial administrator for `npm run seed:admin` (Feature 1)
ADMIN_EMAIL=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# Reservation emails (Feature 9). Use the approved sender account; SMTP_USER/SMTP_PASSWORD go together.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_PASSWORD = an app password.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
